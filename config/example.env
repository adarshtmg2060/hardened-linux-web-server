# =============================================================================
# Copy this file to config/.env and fill in YOUR values.
#   cp config/example.env config/.env
#
# config/.env is listed in .gitignore — never commit real keys, emails or IPs.
# You can also pass any of these as environment variables or CLI flags to
# scripts/setup.sh (CLI flags win over the file).
# =============================================================================

# Public DNS name that must already point at the VM's IPv4 address.
DOMAIN="example.com"

# Address used for Let's Encrypt account registration / expiry notices.
LE_EMAIL="admin@example.com"

# Non-root administrator account to create. Root SSH login is disabled.
ADMIN_USER="deploy"

# Local path to the PUBLIC SSH key that will be installed for ADMIN_USER.
# Example: /home/you/.ssh/id_ed25519.pub
ADMIN_PUBLIC_KEY_PATH="/home/you/.ssh/id_ed25519.pub"

# Set to 1 if DNS has not propagated yet. nginx will be left on HTTP and you
# can re-run `sudo ./scripts/setup.sh` later to obtain the certificate.
SKIP_CERTBOT="0"
